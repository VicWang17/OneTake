# 火山方舟（文生图 Seedream / 视频 Seedance）
ARK_API_KEY=

# DeepSeek（LLM 主力）
DEEPSEEK_API_KEY=

# 阿里云百炼（Qwen LLM 降级 / Qwen-VL 质检）
DASHSCOPE_API_KEY=

# FFmpeg full 版路径（需含 libass 以烧录字幕；macOS homebrew 默认 lite 版不行）
# 不设置时代码按序自动探测：brew /opt/homebrew（arm64）→ brew /usr/local（x86_64）
# → Martin Riedl 静态构建 ~/.local/opt/ffmpeg-mr/bin（免 sudo 兜底）
# FFMPEG_PATH=/usr/local/opt/ffmpeg-full/bin/ffmpeg

# 网关日预算硬熔断（元/天）
DAILY_BUDGET_LIMIT=15
